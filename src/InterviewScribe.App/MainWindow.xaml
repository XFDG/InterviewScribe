<Window x:Class="InterviewScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="面试转写助手"
        Width="1120"
        Height="790"
        MinWidth="940"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StagePillStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F6F9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="TinyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17223B" Padding="34,23">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#6568F2" Margin="0,0,14,0">
                        <TextBlock Text="&#xE8D6;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="面试转写助手" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="视频 → 说话人、时间轴和中英混合文字" Foreground="#BFC8DD" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#20304F" CornerRadius="15" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#54D6A1" Margin="0,0,8,0" />
                        <TextBlock Text="完全本地处理" Foreground="#EAF8F2" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="34,28,34,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="520" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="1  选择录屏" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="支持常见视频和音频格式；一次处理一个文件。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button x:Name="ChangeFileButton"
                                        Grid.Column="1"
                                        Content="选择文件"
                                        Style="{StaticResource TinyButtonStyle}"
                                        Click="BrowseFile_Click" />
                            </Grid>

                            <Border x:Name="DropZoneBorder"
                                    Margin="0,19,0,0"
                                    Padding="24,25"
                                    CornerRadius="11"
                                    BorderThickness="1"
                                    BorderBrush="#C8CDED"
                                    Background="#F8F8FF"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
                                <Grid>
                                    <StackPanel x:Name="EmptyFilePanel" HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE898;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="21"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="把视频拖到这里，或点击选择"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0" />
                                        <TextBlock Text="MP4 / MKV / MOV / AVI / WEBM / 音频"
                                                   Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Grid x:Name="SelectedFilePanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="21"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedFileNameText"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelectedFileDetailsText"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource SuccessSoftBrush}" CornerRadius="12" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="已选择" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="输出位置" FontSize="13" FontWeight="SemiBold" Margin="0,19,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputFolderTextBox"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         ToolTip="TXT、SRT 和 JSON 都会保存到这里" />
                                <Button Grid.Column="1"
                                        Content="更改…"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="9,0,0,0"
                                        Click="BrowseOutput_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="2  处理进度" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        <Border x:Name="StatusBadgeBorder" Background="#F0F2F6" CornerRadius="12" Padding="10,4" Margin="11,0,0,0">
                                            <TextBlock x:Name="StatusBadgeText" Text="等待开始" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusTitleText" Text="选择视频后即可开始" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,0" />
                                    <TextBlock x:Name="StatusDetailText"
                                               Text="首次使用需要下载约 1 GB 的本地模型。"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ProgressPercentText" Text="" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="ElapsedText" Text="" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="OverallProgressBar" Margin="0,17,0,0" Minimum="0" Maximum="100" Value="0" />

                            <WrapPanel Margin="0,16,0,0">
                                <Border x:Name="StageModelBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageModelText" Text="① 模型准备" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageAudioBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageAudioText" Text="② 提取音频" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageTranscribeBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageTranscribeText" Text="③ 识别与分人" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageExportBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageExportText" Text="④ 生成文件" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="识别阶段不会显示虚假的百分比；耗时随视频长度和电脑性能变化。"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,12,0" />
                                <Button x:Name="CancelButton"
                                        Grid.Column="1"
                                        Content="取消"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="Collapsed"
                                        Margin="0,0,9,0"
                                        Click="Cancel_Click" />
                                <Button x:Name="StartButton"
                                        Grid.Column="2"
                                        Content="开始转写"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="125"
                                        IsEnabled="False"
                                        Click="Start_Click" />
                            </Grid>

                            <Expander x:Name="LogExpander" Margin="0,18,0,0" IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="运行记录与诊断" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                </Expander.Header>
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="LogTextBox"
                                             Height="130"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="11" />
                                    <Button Grid.Row="1"
                                            Content="复制诊断信息"
                                            Style="{StaticResource TinyButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0"
                                            Click="CopyLog_Click" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="3  转写完成" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock x:Name="ResultSummaryText" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button x:Name="OpenTxtButton"
                                        Grid.Column="1"
                                        Content="打开 TXT"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,9,0"
                                        Click="OpenTxt_Click" />
                                <Button Grid.Column="2"
                                        Content="打开文件夹"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OpenFolder_Click" />
                            </Grid>
                            <TextBox x:Name="PreviewTextBox"
                                     Margin="0,17,0,0"
                                     Height="270"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="13.5"
                                     TextBlock.LineHeight="23"
                                     Padding="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="识别方案" Style="{StaticResource SectionTitleStyle}" />
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="11" Padding="15" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="MOSS-Transcribe-Diarize" FontSize="14" FontWeight="SemiBold" Foreground="#4145C9" />
                                    <TextBlock Text="Q8_0 · 本地模型" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="中文、英文和中英混说" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="自动区分说话人并保留时间轴" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="输出 TXT、SRT 和结构化 JSON" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,11,0">
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="16"
                                               Foreground="{StaticResource SuccessBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="隐私保护" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="文件不会上传云端" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="视频、临时音频和转写文字都只在这台电脑上处理。首次使用仅下载公开模型文件。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,15,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="给 GPT 分析时" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="优先发送生成的 TXT。它已经按说话人和时间段整理，适合继续做面经总结、问题复盘和回答优化。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="34,11">
            <Grid>
                <TextBlock Text="InterviewScribe · 本地离线转写" Style="{StaticResource CaptionStyle}" />
                <TextBlock x:Name="FooterStatusText" Text="就绪" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
