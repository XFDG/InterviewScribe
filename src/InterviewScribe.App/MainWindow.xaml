<Window x:Class="InterviewScribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaScribe 媒体转写助手"
        Width="1120"
        Height="790"
        MinWidth="940"
        MinHeight="680"
        Icon="/Assets/MediaScribe.png"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="Window_Loaded"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="StagePillStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F6F9" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="TinyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="QueueItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="QueueItemTemplate">
            <Border Background="#FAFBFD" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="8,3" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" />
                    </Border>
                    <Button Grid.Column="2"
                            Content="移除"
                            Tag="{Binding}"
                            Style="{StaticResource TinyButtonStyle}"
                            Padding="8,3"
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Click="RemoveQueueItem_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17223B" Padding="34,23">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#FFFFFF" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="/Assets/MediaScribe.png"
                               Stretch="Uniform"
                               Margin="2" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MediaScribe" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="媒体文件 → 说话人、时间轴和多语言文字" Foreground="#BFC8DD" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#20304F" CornerRadius="15" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ProcessingModeStatusDot" Width="8" Height="8" Fill="#54D6A1" Margin="0,0,8,0" />
                        <TextBlock x:Name="ProcessingModeStatusText" Text="完全本地处理" Foreground="#EAF8F2" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="34,28,34,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="520" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="1  添加媒体文件" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="支持常见视频和音频格式；可一次添加多个文件，按顺序处理。" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button x:Name="ChangeFileButton"
                                        Grid.Column="1"
                                        Content="添加文件"
                                        Style="{StaticResource TinyButtonStyle}"
                                        Click="BrowseFile_Click" />
                            </Grid>

                            <Border x:Name="DropZoneBorder"
                                    Margin="0,19,0,0"
                                    Padding="24,25"
                                    CornerRadius="11"
                                    BorderThickness="1"
                                    BorderBrush="#C8CDED"
                                    Background="#F8F8FF"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
                                <Grid>
                                    <StackPanel x:Name="EmptyFilePanel" HorizontalAlignment="Center">
                                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE898;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="21"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="把视频或音频拖到这里，可一次选择多个"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0" />
                                        <TextBlock Text="MP4 / MKV / MOV / AVI / WEBM / 音频"
                                                   Style="{StaticResource CaptionStyle}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Grid x:Name="SelectedFilePanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="21"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedFileNameText"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelectedFileDetailsText"
                                                       Style="{StaticResource CaptionStyle}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource SuccessSoftBrush}" CornerRadius="12" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedFileStatusText" Text="已加入队列" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid x:Name="QueueHeaderPanel" Margin="0,15,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="QueueSummaryText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                <Button x:Name="ClearQueueButton"
                                        Grid.Column="1"
                                        Content="清空队列"
                                        Style="{StaticResource TinyButtonStyle}"
                                        Click="ClearQueue_Click" />
                            </Grid>
                            <ListBox x:Name="QueueListBox"
                                     Margin="0,8,0,0"
                                     MaxHeight="180"
                                     Visibility="Collapsed"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemTemplate="{StaticResource QueueItemTemplate}"
                                     ItemContainerStyle="{StaticResource QueueItemStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Text="输出位置" FontSize="13" FontWeight="SemiBold" Margin="0,19,0,7" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputFolderTextBox"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"
                                         ToolTip="所选的 TXT、Markdown、Word、PDF、SRT、JSON 文件都会保存到这里" />
                                <Button Grid.Column="1"
                                        Content="更改…"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="9,0,0,0"
                                        Click="BrowseOutput_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProgressCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="2  处理进度" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                        <Border x:Name="StatusBadgeBorder" Background="#F0F2F6" CornerRadius="12" Padding="10,4" Margin="11,0,0,0">
                                            <TextBlock x:Name="StatusBadgeText" Text="等待开始" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusTitleText" Text="添加媒体文件后即可开始" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,0" />
                                    <TextBlock x:Name="StatusDetailText"
                                               Text="首次使用需要下载约 1 GB 的本地模型。"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="ElapsedText" Text="等待开始" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="OverallProgressBar" Margin="0,17,0,0" Minimum="0" Maximum="100" Value="0" />

                            <WrapPanel Margin="0,16,0,0">
                                <Border x:Name="StageModelBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageModelText" Text="① 模型准备" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageAudioBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageAudioText" Text="② 提取音频" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageTranscribeBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageTranscribeText" Text="③ 识别与分人" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                                <Border x:Name="StageExportBorder" Style="{StaticResource StagePillStyle}">
                                    <TextBlock x:Name="StageExportText" Text="④ 生成文件" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="百分比表示全流程完成度；预计剩余时间会在获得足够运行样本后显示。"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,12,0" />
                                <Button x:Name="CancelButton"
                                        Grid.Column="1"
                                        Content="取消并停止队列"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="Collapsed"
                                        Margin="0,0,9,0"
                                        Click="Cancel_Click" />
                                <Button x:Name="StartButton"
                                        Grid.Column="2"
                                        Content="开始转写"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="125"
                                        IsEnabled="False"
                                        Click="Start_Click" />
                            </Grid>

                            <Expander x:Name="LogExpander" Margin="0,18,0,0" IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="运行记录与诊断" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="LogProgressSummaryText"
                                                   Text="0% · 等待开始"
                                                   FontSize="12"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="12,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="LogTextBox"
                                             Height="130"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="11" />
                                    <Button Grid.Row="1"
                                            Content="复制诊断信息"
                                            Style="{StaticResource TinyButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0"
                                            Click="CopyLog_Click" />
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="3  最新转写结果" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock x:Name="ResultSummaryText" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button x:Name="OpenResultButton"
                                        Grid.Column="1"
                                        Content="打开结果"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,9,0"
                                        Click="OpenResult_Click" />
                                <Button Grid.Column="2"
                                        Content="打开文件夹"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OpenFolder_Click" />
                            </Grid>
                            <TextBox x:Name="PreviewTextBox"
                                     Margin="0,17,0,0"
                                     Height="270"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     FontFamily="Microsoft YaHei UI"
                                     FontSize="13.5"
                                     TextBlock.LineHeight="23"
                                     Padding="16" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border x:Name="SettingsPanel" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="转写设置" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="识别语言（可多选）"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,17,0,0" />
                            <UniformGrid Columns="3" Margin="0,11,0,0">
                                <CheckBox x:Name="ChineseLanguageCheckBox"
                                          Content="中文"
                                          IsChecked="True"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="EnglishLanguageCheckBox"
                                          Content="English"
                                          IsChecked="True"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="CantoneseLanguageCheckBox"
                                          Content="粤语"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="JapaneseLanguageCheckBox"
                                          Content="日本語"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="KoreanLanguageCheckBox"
                                          Content="한국어"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="FrenchLanguageCheckBox"
                                          Content="Français"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="GermanLanguageCheckBox"
                                          Content="Deutsch"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="SpanishLanguageCheckBox"
                                          Content="Español"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="PortugueseLanguageCheckBox"
                                          Content="Português"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="RussianLanguageCheckBox"
                                          Content="Русский"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                                <CheckBox x:Name="ItalianLanguageCheckBox"
                                          Content="Italiano"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="LanguageCheckBox_Click" />
                            </UniformGrid>
                            <TextBlock Text="单选会给本地模型语言提示；多选会启用自动识别。Whisper Turbo 覆盖广泛语言；需要更细的中文英文时间轴可选择 Qwen 高精度。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,8,0,0" />
                            <TextBlock x:Name="LanguageValidationText"
                                       Text="请至少选择一种识别语言。"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       Margin="0,7,0,0"
                                       Visibility="Collapsed" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,16" />

                            <TextBlock Text="输出格式（可多选）" FontSize="13" FontWeight="SemiBold" />
                            <UniformGrid Columns="3" Margin="0,11,0,0">
                                <CheckBox x:Name="TxtOutputCheckBox"
                                          Content="TXT"
                                          IsChecked="True"
                                          FontSize="13"
                                          Click="OutputFormatCheckBox_Click" />
                                <CheckBox x:Name="MarkdownOutputCheckBox"
                                          Content="Markdown"
                                          FontSize="13"
                                          Click="OutputFormatCheckBox_Click" />
                                <CheckBox x:Name="DocxOutputCheckBox"
                                          Content="Word"
                                          FontSize="13"
                                          Click="OutputFormatCheckBox_Click" />
                                <CheckBox x:Name="PdfOutputCheckBox"
                                          Content="PDF"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="OutputFormatCheckBox_Click" />
                                <CheckBox x:Name="SrtOutputCheckBox"
                                          Content="SRT"
                                          IsChecked="True"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="OutputFormatCheckBox_Click" />
                                <CheckBox x:Name="JsonOutputCheckBox"
                                          Content="JSON"
                                          IsChecked="True"
                                          FontSize="13"
                                          Margin="0,9,0,0"
                                          Click="OutputFormatCheckBox_Click" />
                            </UniformGrid>
                            <TextBlock x:Name="OutputFormatValidationText"
                                       Text="请至少选择一种输出格式。"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       Margin="0,7,0,0"
                                       Visibility="Collapsed" />
                            <TextBlock Text="Word 输出为 DOCX；PDF 会嵌入系统中文字体。SRT 始终保留字幕时间码，JSON 始终保留完整结构。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,8,0,0" />

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18,0,16" />

                            <TextBlock Text="文件内容" FontSize="13" FontWeight="SemiBold" />
                            <CheckBox x:Name="IncludeTimelineCheckBox"
                                      Content="可读文档包含时间轴"
                                      IsChecked="True"
                                      FontSize="13"
                                      Margin="0,12,0,0" />
                            <CheckBox x:Name="IncludeSpeakersCheckBox"
                                      Content="说话人区分（额外运行本地 MOSS）"
                                      IsChecked="False"
                                      FontSize="13"
                                      Margin="0,11,0,0" />
                            <TextBlock Text="默认关闭以保持快速模式接近 Buzz 的速度。勾选后会额外运行保留的本地 MOSS，并把说话人标签合入结果；时间轴不受影响。两个选项会同时应用于 TXT、Markdown、Word 和 PDF；SRT 只受说话人开关影响。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecognitionModePanel" Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="识别方案" Style="{StaticResource SectionTitleStyle}" />

                            <RadioButton x:Name="WhisperTurboModeRadioButton"
                                         GroupName="TranscriptionMode"
                                         IsChecked="True"
                                         Checked="TranscriptionMode_Checked"
                                         Margin="0,16,0,0"
                                         Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="Whisper Turbo 快速模式（推荐）" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Whisper large-v3-turbo · Faster-Whisper · Windows CUDA 优先 · 断网可用"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Border x:Name="WhisperSetupPanel"
                                    Visibility="Visible"
                                    Background="#F8F8FF"
                                    BorderBrush="#DDE0FA"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="首次使用需下载 Whisper large-v3-turbo 权重与 Faster-Whisper 运行组件。安装后完全离线；程序会优先使用 Windows 原生 CUDA，失败时自动回退 CPU。"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="18" />
                                    <Button x:Name="InstallWhisperRuntimeButton"
                                            Content="安装快速模式组件…"
                                            Style="{StaticResource TinyButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="InstallWhisperRuntime_Click" />
                                </StackPanel>
                            </Border>

                            <RadioButton x:Name="MossLocalModeRadioButton"
                                         GroupName="TranscriptionMode"
                                         Checked="TranscriptionMode_Checked"
                                         Margin="0,15,0,0"
                                         Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="MOSS 本地兼容模式" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="文字、时间轴和说话人一次完成 · Vulkan 优先 · 适合保留现有工作流"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="QwenLocalModeRadioButton"
                                         GroupName="TranscriptionMode"
                                         Checked="TranscriptionMode_Checked"
                                         Margin="0,15,0,0"
                                         Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="Qwen3-ASR + ForcedAligner 高精度" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="官方 ModelScope 权重 · 标准 PyTorch · Windows CUDA 优先 · 逐词时间轴"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Border x:Name="QwenLocalSetupPanel"
                                    Visibility="Collapsed"
                                    Background="#F8F8FF"
                                    BorderBrush="#DDE0FA"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="首次使用通过官方 ModelScope 下载 Qwen3-ASR 1.7B 与 ForcedAligner。模型和标准 PyTorch CUDA 运行环境均保存在本机；安装后可断网运行。"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="18" />
                                    <Button x:Name="InstallQwenRuntimeButton"
                                            Content="安装高精度组件…"
                                            Style="{StaticResource TinyButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            Click="InstallQwenRuntime_Click" />
                                </StackPanel>
                            </Border>


                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="11" Padding="15" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="RecognitionSummaryTitleText"
                                               Text="Whisper Turbo + Faster-Whisper"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#4145C9" />
                                    <TextBlock x:Name="RecognitionSummaryDetailText"
                                               Text="文字与时间轴由 Whisper Turbo 生成；说话人区分可按需交给本地 MOSS。"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="11 种语言可选，支持多语言混说" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="自动区分说话人并保留时间轴" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="TXT / MD / Word / PDF / SRT / JSON 可多选" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PrivacyIconBorder" Width="34" Height="34" CornerRadius="17" Background="{StaticResource SuccessSoftBrush}" Margin="0,0,11,0">
                                    <TextBlock x:Name="PrivacyIconText" Text="&#xE72E;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="16"
                                               Foreground="{StaticResource SuccessBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="PrivacyTitleText" Text="隐私保护" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PrivacySubtitleText" Text="文件不会上传云端" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="PrivacyDetailText"
                                       Text="视频、临时音频和转写文字都只在这台电脑上处理。首次使用仅下载公开模型文件。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,15,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="给 GPT 分析时" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="优先发送生成的 TXT。它会按你的选项整理，适合继续做面经总结、问题复盘和回答优化。"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="34,11">
            <Grid>
                <TextBlock x:Name="FooterModeText" Text="MediaScribe · 本地离线转写" Style="{StaticResource CaptionStyle}" />
                <TextBlock x:Name="FooterStatusText" Text="就绪" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
